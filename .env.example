# API Configuration
# Replace this with your AWS Lambda API Gateway URL when available
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Examples:
# Local development:
# NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# AWS Lambda (API Gateway):
# NEXT_PUBLIC_API_BASE_URL=https://your-api-id.execute-api.region.amazonaws.com/prod
# NEXT_PUBLIC_API_BASE_URL=https://your-api-id.execute-api.us-east-1.amazonaws.com/prod

# Production domain with custom domain:
# NEXT_PUBLIC_API_BASE_URL=https://api.chinawok.com
