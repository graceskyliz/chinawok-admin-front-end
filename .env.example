# WebSocket Configuration
# URL del WebSocket API Gateway (debe incluir el stage, ej: /dev o /production)
# Nota: El WebSocket requiere usuario_correo y pedido_id como parámetros de conexión
NEXT_PUBLIC_WS_URL=wss://your-api-id.execute-api.us-east-1.amazonaws.com/dev

# Microservices REST APIs
NEXT_PUBLIC_API_USUARIOS_URL=https://your-api.execute-api.us-east-1.amazonaws.com/usuarios
NEXT_PUBLIC_API_LOCALES_URL=https://your-api.execute-api.us-east-1.amazonaws.com/locales
NEXT_PUBLIC_API_PEDIDOS_URL=https://your-api.execute-api.us-east-1.amazonaws.com/pedidos
NEXT_PUBLIC_API_EMPLEADOS_URL=https://your-api.execute-api.us-east-1.amazonaws.com/empleados

# Ejemplo para desarrollo local:
# NEXT_PUBLIC_WS_URL=ws://localhost:3001
# NEXT_PUBLIC_API_PEDIDOS_URL=http://localhost:3000/pedidos
